# =========================
# CONFIGURACION DEL PROYECTO
#
# Copia este archivo a ".env" y rellena los valores.
# El archivo .env NUNCA se sube a git ni se comparte: esta en .gitignore.
#
#   cp .env.example .env
# =========================


# --- OBLIGATORIO ---

# Clave con la que se firman las sesiones.
# Si cambias este valor, se cierran todas las sesiones abiertas.
# Genera una asi:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria


# --- SERVIDOR ---

# Puerto en el que escucha. En local 3000; en el servidor lo suele
# fijar el propio hosting.
PORT=3000

# "development" en tu ordenador, "production" en el servidor.
# En produccion la cookie de sesion solo viaja por HTTPS y no se
# muestran detalles de los errores al navegador.
NODE_ENV=development

# Ponlo a true SOLO si el sitio va detras de Nginx, Apache, Render,
# Railway, Cloudflare o similar. Hace que el servidor lea la IP real
# del visitante en vez de la del proxy.
TRUST_PROXY=false


# --- SESION ---

# Cuanto dura la sesion: 7d = 7 dias, 12h = 12 horas, 30m = 30 minutos
JWT_EXPIRES_IN=7d


# --- CORS ---

# Dejalo VACIO si el frontend y la API estan en el mismo dominio,
# que es el caso ahora mismo. Solo hace falta si algun dia sirves el
# frontend desde otro dominio o haces una app movil.
# Varios dominios separados por coma, sin barra al final:
#   CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com
CORS_ORIGIN=


# --- MONGODB ---
#
# SI PONES ESTA VARIABLE, el proyecto usa MongoDB.
# SI LA DEJAS VACIA, usa los archivos JSON de la carpeta data/.
#
# Los dos modos hacen exactamente lo mismo (se comprueba con
# "npm run test-motores"), pero para el servidor de produccion hay que
# usar MongoDB: los archivos no aguantan varias compras a la vez.
#
# MongoDB instalado en tu propio ordenador:
#   MONGODB_URI=mongodb://127.0.0.1:27017/marketplace
#
# MongoDB Atlas (en la nube, tiene plan gratuito):
#   MONGODB_URI=mongodb+srv://usuario:clave@servidor.mongodb.net/marketplace
#
# La primera vez, despues de ponerla:  npm run migrar-mongo
# Ese comando copia los datos de data/ a MongoDB y COMPRUEBA uno a uno
# que llegaron bien. No borra nada de data/.
MONGODB_URI=

# Opcional: nombre de la base de datos, si no va incluido en la URI.
# MONGODB_DB=marketplace


# --- LIMITE DE INTENTOS DE LOGIN ---

# Intentos fallidos permitidos por IP cada 15 minutos.
# En produccion deja 10. Subelo solo mientras pruebas el sitio tu mismo.
LOGIN_MAX_INTENTOS=10

# Peticiones a la API por IP y por minuto (no cuenta paginas ni imagenes).
API_MAX_PETICIONES=300
